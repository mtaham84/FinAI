# Copy this file to .env and fill in real values. Never commit .env.

DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=True

# PostgreSQL (required)
POSTGRES_DB=finai
POSTGRES_USER=finai
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Gmail SMTP for email verification (use a Gmail App Password, never your login password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=sitebartar3@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
DEFAULT_FROM_EMAIL=sitebartar3@gmail.com

# Future provider credentials (placeholders only -- nothing wired up yet):
# NOBITEX_API_KEY=
# SMS_PROVIDER_API_KEY=
